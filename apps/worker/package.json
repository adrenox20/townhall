{
  "name": "@grievance/worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --config wrangler.toml --local --persist-to=.wrangler/state",
    "deploy": "wrangler deploy --config wrangler.toml",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 execute university-grievance-db --local --file=../../schema.sql",
    "db:seed:local": "wrangler d1 execute university-grievance-db --local --file=../../seed.sql"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.8.0",
    "hono": "^4.7.2",
    "jose": "^6.2.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260524.1",
    "typescript": "^6.0.3",
    "wrangler": "^4.94.0"
  }
}
